# Port the API listens on (the server respects PORT from the environment).
PORT=5000

# MongoDB connection string.
MONGO_URI=mongodb+srv://phharmon:YlwHBMNg67AI9E2X@cluster0.hgi0s.mongodb.net/blogdb

# Secret used to sign JWTs. Set a long random value in production.
JWT_SECRET=WhateverDoesThisMean@1

# Frontend origin(s) for production CORS. Comma-separated list, e.g.
# CLIENT_URL=https://blog.example.com,https://www.blog.example.com
# When unset, CORS allows all origins (dev default).
CLIENT_URL=https://personal-blog-client.onrender.com

# Seed credentials for the blog admin account (Philip).
ADMIN_EMAIL=phharmon@outlook.com
ADMIN_PASSWORD=Wyattmonroe9

# Contact-form email notifications (optional). Gmail recommended:
# turn on 2-Step Verification, then generate an App Password at
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# Never commit real values here — set them in the hosting dashboard.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=phharmon73@gmail.com
SMTP_PASS=Pepperlangston@8
# Where notification emails go. Defaults to ADMIN_EMAIL when unset.
NOTIFY_EMAIL=phharmon73@gmail.com
